---
import type { Menu } from '../lib/db';

interface Props {
  title?: string;
  description?: string;
  menus?: Menu[];
  siteSettings?: Record<string, string>;
}

const { 
  title = "LUMI CASA — Smart Home", 
  description = "LUMI CASA - Giải pháp nhà thông minh, sản phẩm và dịch vụ Smart Home.",
  menus = [],
  siteSettings = {}
} = Astro.props;

const siteName = siteSettings.site_name || "LUMI CASA";
---

<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <style is:global>
    :root{
      --bg:#07111d;--surface:#0d1b2a;--surface2:#10243a;--ink:#f4f8fb;--muted:#9eb2c7;
      --line:rgba(255,255,255,.11);--accent:#59e1c5;--accent2:#8aa7ff;--max:1180px;--r:24px;
      --shadow:0 24px 70px rgba(0,0,0,.28)
    }
    *{box-sizing:border-box}html{scroll-behavior:smooth}
    body{margin:0;background:radial-gradient(circle at 20% 0%,rgba(89,225,197,.10),transparent 32%),var(--bg);color:var(--ink);font-family:"Be Vietnam Pro","Segoe UI",Arial,sans-serif;line-height:1.6}
    a{color:inherit;text-decoration:none}button,input,textarea{font:inherit}.wrap{width:min(var(--max),calc(100% - 36px));margin:auto}
    header{position:sticky;top:0;z-index:50;background:rgba(7,17,29,.78);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}
    .nav{height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px}
    .brand{display:flex;align-items:center;gap:12px;font-weight:800;letter-spacing:.08em}
    .brand-mark{width:36px;height:36px;border-radius:12px;background:linear-gradient(135deg,var(--accent),var(--accent2));box-shadow:0 0 32px rgba(89,225,197,.25)}
    nav{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
    .nav-link{border:0;background:transparent;color:var(--muted);padding:10px 14px;border-radius:999px;cursor:pointer}
    .nav-link:hover,.nav-link.active{color:var(--ink);background:rgba(255,255,255,.08)}
    .nav-cta{padding:10px 16px;border:1px solid rgba(89,225,197,.35);color:var(--accent);border-radius:999px}
    main{min-height:calc(100vh - 76px)}
    .page{display:none;animation:fade .34s ease}
    .page.active{display:block}
    @keyframes fade{from{opacity:.3;transform:translateY(8px)}to{opacity:1;transform:none}}
    .hero{padding:88px 0 64px;display:grid;grid-template-columns:1.05fr .95fr;gap:52px;align-items:center}
    .eyebrow{display:inline-flex;gap:8px;align-items:center;padding:7px 11px;border:1px solid var(--line);border-radius:999px;color:var(--accent);font-size:13px;text-transform:uppercase;letter-spacing:.12em}
    .hero h1,.page-head h1{font-size:clamp(44px,7vw,84px);line-height:1.02;margin:18px 0 18px;letter-spacing:-.045em}
    .hero p,.page-head p{color:var(--muted);font-size:18px;max-width:680px}
    .hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}
    .btn{display:inline-flex;align-items:center;justify-content:center;padding:13px 18px;border-radius:14px;border:1px solid var(--line);font-weight:700;cursor:pointer;background:rgba(255,255,255,.04);color:var(--ink)}
    .btn.primary{background:var(--accent);color:#052018;border-color:transparent}
    .hero-media{border:1px solid var(--line);background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.02));border-radius:32px;padding:22px;box-shadow:var(--shadow);position:relative;overflow:hidden}
    .hero-media img{width:100%;display:block;border-radius:22px;aspect-ratio:4/3;object-fit:cover}
    .statbar{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:14px}
    .stat{padding:16px;border-radius:16px;background:#0a1725;border:1px solid var(--line)}
    .stat strong{display:block;font-size:22px}.stat span{color:var(--muted);font-size:13px}
    .section{padding:72px 0}.section-title{display:flex;justify-content:space-between;gap:24px;align-items:end;margin-bottom:28px}
    .section-title h2{font-size:clamp(30px,5vw,52px);line-height:1.05;margin:0}.section-title p{max-width:560px;color:var(--muted);margin:0}
    .grid{display:grid;gap:20px}.grid.products{grid-template-columns:repeat(4,1fr)}.grid.services{grid-template-columns:repeat(3,1fr)}
    .card{background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.025));border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
    .card-media{padding:18px 18px 0}.card-media img{width:100%;aspect-ratio:1.15/1;object-fit:cover;border-radius:18px;background:#dce7ed}
    .card-body{padding:20px}.card-kicker{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent)}
    .card h3{margin:8px 0 8px;font-size:22px}.card p{margin:0;color:var(--muted)}.price{margin-top:18px;font-size:20px;font-weight:800}
    .service-card{padding:18px}.service-photo{margin-bottom:18px}.service-photo img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:18px;display:block}
    .service-icon{width:54px;height:54px;border-radius:16px;display:grid;place-items:center;background:rgba(89,225,197,.1);border:1px solid rgba(89,225,197,.25);font-size:24px;margin-bottom:18px}
    .service-card small{color:var(--accent);letter-spacing:.12em}.service-card h3{margin:7px 0 9px}.service-card p{color:var(--muted);margin:0}.service-card ul{padding-left:18px;color:#c8d6e3}
    .page-head{padding:72px 0 34px}.page-head h1{font-size:clamp(42px,6vw,68px)}
    .contact-layout{display:grid;grid-template-columns:.85fr 1.15fr;gap:24px}
    .contact-card,.form-card{border:1px solid var(--line);border-radius:28px;padding:28px;background:rgba(255,255,255,.035)}
    .contact-list{display:grid;gap:16px;margin-top:26px}.contact-item{padding:15px 0;border-bottom:1px solid var(--line)}
    .contact-item:last-child{border-bottom:0}.contact-item span{display:block;color:var(--muted);font-size:13px}.contact-item strong{display:block;margin-top:4px}
    .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}
    .field label{font-size:13px;color:#c8d6e3}
    .field input,.field textarea{width:100%;border:1px solid var(--line);background:#091522;color:var(--ink);padding:13px 14px;border-radius:14px;outline:none}
    .field input:focus,.field textarea:focus{border-color:rgba(89,225,197,.65);box-shadow:0 0 0 3px rgba(89,225,197,.09)}
    .field textarea{min-height:140px;resize:vertical}.form-note{font-size:13px;color:var(--muted);margin-top:12px}
    .banner{margin:72px auto;padding:34px;border-radius:28px;background:linear-gradient(135deg,#143d45,#162b4b);border:1px solid var(--line);display:flex;justify-content:space-between;gap:30px;align-items:center}
    .banner h3{font-size:32px;margin:0 0 8px}.banner p{margin:0;color:#bdd0dc}
    .footer{border-top:1px solid var(--line);padding:26px 0 38px;color:var(--muted);font-size:14px}
    .footer-inner{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
    .toast{position:fixed;right:20px;bottom:20px;z-index:70;background:#eefaf7;color:#0b2a22;padding:14px 16px;border-radius:14px;box-shadow:var(--shadow);display:none}
    .toast.show{display:block;animation:fade .25s ease}
    @media(max-width:940px){.hero,.contact-layout{grid-template-columns:1fr}.grid.products{grid-template-columns:repeat(2,1fr)}.grid.services{grid-template-columns:repeat(2,1fr)}.hero{padding-top:54px}.hero-media{order:-1}}
    @media(max-width:680px){.nav{height:auto;padding:14px 0;align-items:flex-start}.brand{padding-top:7px}nav{justify-content:flex-end}.nav-link{padding:8px 10px;font-size:13px}.nav-cta{display:none}.grid.products,.grid.services,.form-grid{grid-template-columns:1fr}.hero h1,.page-head h1{font-size:42px}.section{padding:54px 0}.section-title,.banner{align-items:flex-start;flex-direction:column}.statbar{grid-template-columns:1fr}.field.full{grid-column:auto}}
  </style>
</head>
<body>
  <header>
    <div class="wrap nav">
      <a class="brand" href="#home" data-route="home" aria-label="Về trang chủ">
        <span class="brand-mark"></span><span>{siteName}</span>
      </a>
      <nav aria-label="Điều hướng chính">
        {menus.map((item) => (
          item.is_cta ? (
            <a class="nav-cta" href={`#${item.route}`} data-route={item.route}>{item.label}</a>
          ) : (
            <button class={`nav-link ${item.route === 'home' ? 'active' : ''}`} data-route={item.route}>{item.label}</button>
          )
        ))}
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <span>{siteSettings.footer_copy || "© 2026 LUMI CASA — Demo website."}</span>
      <span>{siteSettings.footer_sub || "Smart Home • Security • Automation"}</span>
    </div>
  </footer>

  <div class="toast" id="toast" role="status" aria-live="polite">Đã nhận thông tin liên hệ. Cảm ơn bạn!</div>

    <script is:inline>
    (()=>{
      // 1. Điều hướng chuyển Tab mượt mà
      const pages=[...document.querySelectorAll('[data-page]')];
      const links=[...document.querySelectorAll('[data-route]')];
      const valid=['home','products','services','contact'];
      function show(route,push=true){
        if(!valid.includes(route)) route='home';
        pages.forEach(p=>p.classList.toggle('active',p.dataset.page===route));
        document.querySelectorAll('.nav-link').forEach(l=>l.classList.toggle('active',l.dataset.route===route));
        if(push && location.hash!=='#'+route) history.pushState({route},'', '#'+route);
        window.scrollTo({top:0,behavior:'smooth'});
        document.title = ({home:'LUMI CASA — Smart Home',products:'Sản phẩm — LUMI CASA',services:'Dịch vụ — LUMI CASA',contact:'Liên hệ — LUMI CASA'})[route] || 'LUMI CASA';
      }
      links.forEach(el=>el.addEventListener('click',e=>{e.preventDefault();show(el.dataset.route)}));
      window.addEventListener('popstate',()=>show(location.hash.slice(1)||'home',false));
      window.addEventListener('hashchange',()=>show(location.hash.slice(1)||'home',false));
      show(location.hash.slice(1)||'home',false);

      // 2. Xử lý gửi Form liên hệ thật vào D1
      const form = document.getElementById('contactForm');
      const toast = document.getElementById('toast');

      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          const submitBtn = form.querySelector('button[type="submit"]');
          const formData = new FormData(form);
          const payload = {
            name: formData.get('name'),
            phone: formData.get('phone'),
            homeType: formData.get('homeType'),
            budget: formData.get('budget'),
            message: formData.get('message')
          };

          try {
            if (submitBtn) submitBtn.disabled = true;
            
            const response = await fetch('/api/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            const result = await response.json();

            if (response.ok) {
              toast.textContent = result.message || 'Gửi liên hệ thành công!';
              toast.style.background = '#eefaf7';
              toast.style.color = '#0b2a22';
              toast.classList.add('show');
              form.reset();
            } else {
              toast.textContent = result.error || 'Có lỗi xảy ra, vui lòng thử lại.';
              toast.style.background = '#ffebee';
              toast.style.color = '#c62828';
              toast.classList.add('show');
            }
          } catch (err) {
            toast.textContent = 'Lỗi kết nối máy chủ.';
            toast.classList.add('show');
          } finally {
            if (submitBtn) submitBtn.disabled = false;
            setTimeout(() => toast.classList.remove('show'), 3500);
          }
        });
      }
    })();
  </script>
</body>
</html>