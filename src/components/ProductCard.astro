---
import { resolveImageUrl } from '../lib/db';

interface Props {
  product: any;
}

const { product } = Astro.props;

// Xử lý giá tiền hiển thị
const displayPrice = product.price_display || (product.price ? `${Number(product.price).toLocaleString('vi-VN')}đ` : 'Liên hệ');

// Tự động giải mã link ảnh từ EmDash Media Library hoặc dùng ảnh dự phòng
const fallbackImage = 'https://images.pexels.com/photos/30170004/pexels-photo-30170004.jpeg?auto=compress&cs=tinysrgb&w=1200';
const imageUrl = resolveImageUrl(product.image || product.image_url, fallbackImage);
---

<article class="card">
  <div class="card-media">
    <img 
      loading="lazy" 
      src={imageUrl} 
      alt={product.name || 'Sản phẩm Smart Home'} 
    />
  </div>
  <div class="card-body">
    <span class="card-kicker">{product.group_label || 'Thiết bị'}</span>
    <h3>{product.name}</h3>
    <p>{product.description}</p>
    <div class="price">{displayPrice}</div>
  </div>
</article>