---
import { resolveImageUrl } from '../lib/db';

interface Props {
  service: any;
}

const { service } = Astro.props;

// Tách các gạch đầu dòng tính năng (phân tách bởi dấu |)
const featuresList = service.features ? service.features.split('|') : [];

// Tự động giải mã link ảnh từ EmDash Media Library
const fallbackImage = 'https://images.pexels.com/photos/28618498/pexels-photo-28618498.jpeg?auto=compress&cs=tinysrgb&w=1000';
const imageUrl = resolveImageUrl(service.image || service.image_url, fallbackImage);
---

<article class="card service-card">
  <div class="service-photo">
    <img 
      loading="lazy" 
      src={imageUrl} 
      alt={service.name || 'Dịch vụ'} 
    />
  </div>
  <div class="service-icon">{service.icon || '✦'}</div>
  <small>{service.order_code || '01'}</small>
  <h3>{service.name}</h3>
  <p>{service.description}</p>
  {featuresList.length > 0 && (
    <ul>
      {featuresList.map((item: string) => (
        <li>{item.trim()}</li>
      ))}
    </ul>
  )}
</article>